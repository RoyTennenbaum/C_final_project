; Position calculation macro

; Element loading macro

; Set matrix coordinates
        mov #1, ROW_VAL
        mov #2, COL_VAL
MATRIX: .mat [2][3] 1, 2, 3, 4, 5, 6
ROW_VAL: .data 3
COL_VAL: .data 3
INDEX: .data 0

; Load matrix element
        mov MATRIX[r1][r2], VALUE

.entry MATRIX
VALUE: .data 0
; Display the loaded value
        prn VALUE
        stop
.entry VALUE