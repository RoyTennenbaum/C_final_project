; Counter initialization macro
macro INIT_COUNTER
        mov #6, COUNT
        mov #0, STEP_COUNT
mcroend

; Decrement operation macro

; Start counter program
        dec #14
COUNT: .data 0
STEP_COUNT: .data 0
; Perform decrement step
LOOP:   DECREMENT_STEP
.entry LOOP  
; Check if counter reached zero
        cmp COUNT, #0
     ; Continue if not zero
        bne LOOP
END_MSG: .str "Steps taken:"
                ; Display final results
        prn END_MSG
        bne STEP
        stp
.entry STEP_COUNT