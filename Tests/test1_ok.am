; Array search macro definitions


; Initialize array processing
        lea ARRAY, r0
        mov #5, r1

ARRAY: .data 10, 20, 30, 15, 25
        mov #20, r2
.entry SEARCH
; Load element at index 1
SEARCH: mov ARRAY, r3
; Compare with target
        cmp r3, r2
FOUND: .data 0
; Branch if not equal
        bne FOUND
; Set found flag
        mov #1, FOUND
.entry FOUND